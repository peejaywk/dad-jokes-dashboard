{
  "separate-pull-requests": true,
  "packages": {
    "apps/api": {
      "release-type": "python",
      "package-name": "dad-jokes-dashboard-backend",
      "component": "api",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='dad-jokes-dashboard-backend')].version"
        }
      ]
    },
    "apps/web": {
      "release-type": "simple",
      "package-name": "dad-jokes-web",
      "component": "web",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md"
    }
  }
}
